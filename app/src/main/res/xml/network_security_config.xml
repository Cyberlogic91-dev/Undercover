<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune connexion en clair : tout passe en HTTPS / TLS -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
